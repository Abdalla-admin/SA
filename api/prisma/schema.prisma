generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CEO
  FINANCE_MANAGER
  ENGINEERING_MANAGER
  PROJECT_COORDINATOR
  ACCOUNTANT
  TECHNICIAN
}

enum LeadStatus {
  NEW
  SURVEY_SCHEDULED
  SURVEY_DONE
  PROPOSAL_SENT
  CEO_APPROVAL_PENDING
  CEO_APPROVED
  CLIENT_APPROVAL_PENDING
  CLIENT_APPROVED
  CONTRACTED
  LOST
}

enum ProjectStatus {
  PLANNING
  DESIGN
  PROCUREMENT
  EXECUTION
  COMMISSIONING
  COMPLETED
  ON_HOLD
}

enum DesignStatus {
  DRAFT
  INTERNAL_REVIEW
  ENG_APPROVED
  SENT_TO_CLIENT
  CLIENT_APPROVED
}

enum ContractStatus {
  DRAFT
  INTERNAL_REVIEW
  FINANCE_APPROVED
  SENT_TO_CLIENT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(TECHNICIAN)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assignedLeads   Lead[]           @relation("LeadCoordinator")
  notifications   Notification[]
  userPermissions UserPermission[]
}

model UserPermission {
  id         Int     @id @default(autoincrement())
  userId     Int
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     String
  canView    Boolean @default(false)
  canCreate  Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)
  canSpecial Boolean @default(false)

  @@unique([userId, module])
}

model RolePermission {
  id         Int     @id @default(autoincrement())
  role       String
  module     String
  canView    Boolean @default(false)
  canCreate  Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)
  canSpecial Boolean @default(false)

  @@unique([role, module])
}

model Customer {
  id               Int       @id @default(autoincrement())
  name             String
  email            String?
  phone            String?
  address          String?
  siteLocation     String?
  notes            String?
  registrationDate DateTime?
  createdAt        DateTime  @default(now())

  leads      Lead[]
  projects   Project[]
  quotations Quotation[]
  contracts  Contract[]
  invoices   Invoice[]
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  category  String?
  notes     String?
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Employee {
  id         Int       @id @default(autoincrement())
  name       String
  email      String?
  phone      String?
  position   String?
  department String?
  salary     Float     @default(0)
  joinDate   DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  attendance Attendance[]
  leaves     Leave[]
  payslips   Payslip[]
}

model Lead {
  id                Int        @id @default(autoincrement())
  title             String
  customerId        Int?
  customer          Customer?  @relation(fields: [customerId], references: [id])
  source            String?
  systemType        String?
  structureType     String?
  estimatedCapacity Float?
  siteAddress       String?
  status            LeadStatus @default(NEW)
  coordinatorId     Int?
  coordinator       User?      @relation("LeadCoordinator", fields: [coordinatorId], references: [id])
  surveyDate        DateTime?
  surveyNotes       String?
  requirementReport String?
  proposalAmount    Float?
  ceoApprovedAt     DateTime?
  ceoApprovedBy     String?
  clientApprovedAt  DateTime?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  project Project?
}

model Project {
  id             Int           @id @default(autoincrement())
  name           String
  leadId         Int?          @unique
  lead           Lead?         @relation(fields: [leadId], references: [id])
  customerId     Int?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  contractId     Int?          @unique
  contract       Contract?     @relation(fields: [contractId], references: [id])
  systemCapacity Float?
  status         ProjectStatus @default(PLANNING)
  budget         Float?
  startDate      DateTime?
  targetDate     DateTime?
  completionDate DateTime?
  progressPct    Int           @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  design              Design?
  milestones          Milestone[]
  materialAllocations MaterialAllocation[]
  snagItems           SnagItem[]
  commissioningTests  CommissioningTest[]
  warranty            Warranty?
  expenses            Expense[]
  maintenanceRequests MaintenanceRequest[]
}

model Design {
  id                   Int          @id @default(autoincrement())
  projectId            Int          @unique
  project              Project      @relation(fields: [projectId], references: [id])
  status               DesignStatus @default(DRAFT)
  systemCapacity       Float?
  panelCount           Int?
  inverterType         String?
  mountingType         String?
  designNotes          String?
  fileUrl              String?
  internalReviewedAt   DateTime?
  internalReviewedBy   String?
  engApprovedAt        DateTime?
  engApprovedBy        String?
  sentToClientAt       DateTime?
  clientApprovedAt     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Milestone {
  id          Int       @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id])
  title       String
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

model SnagItem {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id])
  description String
  status      String   @default("OPEN")
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
}

model CommissioningTest {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  testName  String
  result    String   @default("PENDING")
  testedAt  DateTime?
  notes     String?
  createdAt DateTime @default(now())
}

model Warranty {
  id                Int      @id @default(autoincrement())
  projectId         Int      @unique
  project           Project  @relation(fields: [projectId], references: [id])
  startDate         DateTime
  endDate           DateTime
  terms             String?
  maintenancePeriod String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())

  maintenanceRequests MaintenanceRequest[]
}

model MaintenanceRequest {
  id          Int       @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id])
  warrantyId  Int?
  warranty    Warranty? @relation(fields: [warrantyId], references: [id])
  type        String?
  description String?
  status      String    @default("OPEN")
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

model Material {
  id        Int      @id @default(autoincrement())
  name      String
  category  String?
  unit      String   @default("pcs")
  quantity  Float    @default(0)
  minStock  Float    @default(0)
  unitCost  Float    @default(0)
  brand     String?
  specs     String?
  createdAt DateTime @default(now())

  purchaseItems PurchaseItem[]
  allocations   MaterialAllocation[]
}

model MaterialAllocation {
  id          Int      @id @default(autoincrement())
  materialId  Int
  material    Material @relation(fields: [materialId], references: [id])
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id])
  quantity    Float
  allocatedAt DateTime @default(now())
  notes       String?
}

model Purchase {
  id             Int            @id @default(autoincrement())
  vendorId       Int?
  vendor         Vendor?        @relation(fields: [vendorId], references: [id])
  bankAccountId  Int?
  bankAccount    BankAccount?   @relation(fields: [bankAccountId], references: [id])
  status         PurchaseStatus @default(PENDING)
  orderDate      DateTime       @default(now())
  receivedAt     DateTime?
  totalAmount    Float          @default(0)
  notes          String?
  createdAt      DateTime       @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  materialId Int
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Float
  unitCost   Float
  totalCost  Float
}

model Quotation {
  id             Int             @id @default(autoincrement())
  customerId     Int?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  status         QuotationStatus @default(DRAFT)
  systemCapacity Float?
  validUntil     DateTime?
  subtotal       Float           @default(0)
  tax            Float           @default(0)
  total          Float           @default(0)
  notes          String?
  createdAt      DateTime        @default(now())

  items   QuotationItem[]
  invoice Invoice?
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  description String
  quantity    Float
  unitPrice   Float
  total       Float
}

model Contract {
  id                Int            @id @default(autoincrement())
  customerId        Int?
  customer          Customer?      @relation(fields: [customerId], references: [id])
  title             String
  value             Float          @default(0)
  paymentTerms      String?
  startDate         DateTime?
  endDate           DateTime?
  status            ContractStatus @default(DRAFT)
  financeApprovedAt DateTime?
  signedAt          DateTime?
  notes             String?
  createdAt         DateTime       @default(now())

  project  Project?
  invoices Invoice[]
}

model Invoice {
  id          Int           @id @default(autoincrement())
  customerId  Int?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  contractId  Int?
  contract    Contract?     @relation(fields: [contractId], references: [id])
  quotationId Int?          @unique
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  status      InvoiceStatus @default(UNPAID)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  subtotal    Float         @default(0)
  tax         Float         @default(0)
  total       Float         @default(0)
  notes       String?
  createdAt   DateTime      @default(now())

  payments Payment[]
  items    InvoiceItem[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Float
  unitPrice   Float
  total       Float
}

model Payment {
  id            Int          @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice      @relation(fields: [invoiceId], references: [id])
  bankAccountId Int?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  amount        Float
  method        String?
  reference     String?
  paidAt        DateTime     @default(now())
  notes         String?
  createdAt     DateTime     @default(now())
}

model Expense {
  id            Int          @id @default(autoincrement())
  projectId     Int?
  project       Project?     @relation(fields: [projectId], references: [id])
  bankAccountId Int?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  category      String?
  description   String?
  amount        Float
  expenseDate   DateTime     @default(now())
  createdAt     DateTime     @default(now())
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  name          String
  bankName      String?
  accountNumber String?
  balance       Float    @default(0)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())

  payments      Payment[]
  expenses      Expense[]
  purchases     Purchase[]
  transfersFrom FundTransfer[]   @relation("FromAccount")
  transfersTo   FundTransfer[]   @relation("ToAccount")
  transactions  BankTransaction[]
}

model BankTransaction {
  id              Int         @id @default(autoincrement())
  bankAccountId   Int
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  type            String
  amount          Float
  description     String?
  transactionDate DateTime    @default(now())
  createdAt       DateTime    @default(now())
}

model FundTransfer {
  id            Int         @id @default(autoincrement())
  fromAccountId Int
  fromAccount   BankAccount @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccountId   Int
  toAccount     BankAccount @relation("ToAccount", fields: [toAccountId], references: [id])
  amount        Float
  reference     String?
  notes         String?
  transferDate  DateTime    @default(now())
  createdAt     DateTime    @default(now())
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime
  status     String   @default("PRESENT")
  notes      String?
  createdAt  DateTime @default(now())
}

model Leave {
  id         Int         @id @default(autoincrement())
  employeeId Int
  employee   Employee    @relation(fields: [employeeId], references: [id])
  type       String?
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
}

model Payslip {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id])
  month       Int
  year        Int
  basicSalary Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netPay      Float
  paidAt      DateTime?
  createdAt   DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
